# Server-side only — never prefix these with VITE_, or Vite inlines them
# into the browser bundle and they become public.

GITHUB_USERNAME=nama-github-kamu

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxx

WAKATIME_API_KEY=waka_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=emailxxx.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Empty follows gemini-flash-latest, which survives Google retiring a
# version. Pin one to choose for yourself, e.g. gemini-3-flash-preview.
GEMINI_MODEL=

# Set to 1 to have /api/chat return Google's own error text alongside the
# friendly message, so a failing chat can be diagnosed from the browser.
# Leave it empty in production — visitors have no use for it.
CHAT_DEBUG=

# Optional. The visitor counter keeps its number on abacus.jasoncameron.dev —
# a free, public counter service, so no database of your own. The namespace is
# the only thing protecting the count: it is public and unauthenticated, so
# anyone who learns this string can inflate the number. Leave it empty to use
# the built-in random namespace; set your own random string to take it over, or
# to reset a count that got spammed.
VISITOR_COUNTER_NAMESPACE=
