{
  "extends": [
    "development"
  ],
  "hints": {
    "css-prefix-order": "off",
    "no-inline-styles": "off",
    "axe/name-role-value": [
      "default",
      {
        "link-name": "off"
      }
    ],
    "axe/text-alternatives": [
      "default",
      {
        "document-title": "off"
      }
    ],
    "axe/language": "off",
    "meta-viewport": "off"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not chrome <= 109",
    "not ios_saf <= 18.5",
    "not safari <= 18.5",
    "not samsung <= 27",
    "not and_ff <= 137",
    "not firefox <= 138",
    "not opera <= 117"
  ]
}